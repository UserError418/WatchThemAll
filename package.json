{
  "name": "watchthemall",
  "version": "1.9.5",
  "description": "Desktop client for navigating video embed providers, with a TMDB browse surface and episode release tracking.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "legacy:start": "electron legacy/",
    "legacy:test": "node --test legacy/test/*.js",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "probe:providers": "electron-vite build && electron . --no-sandbox --probe-providers",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "sync:mobile": "cap sync android",
    "apk": "scripts/build-apk.sh",
    "probe:streams": "electron-vite build && electron . --no-sandbox --extract-streams",
    "probe:playback": "scripts/probe-playback.py",
    "probe:ui": "electron-vite build && electron . --no-sandbox --probe-ui",
    "probe:quality": "electron-vite build && electron . --no-sandbox --probe-quality"
  },
  "build": {
    "appId": "net.watchthemall.app",
    "productName": "WatchThemAll",
    "icon": "icons/icon512.png",
    "directories": {
      "output": "dist-packages"
    },
    "files": [
      "out/**",
      "!out/mobile/**",
      "icons/**",
      "package.json",
      "!node_modules/@capacitor/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icons/icon512.png",
      "category": "Video",
      "executableName": "watchthemall",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "watchthemall"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon512.png",
      "category": "public.app-category.entertainment"
    },
    "asarUnpack": []
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "author": {
    "name": "The WatchThemAll contributors",
    "email": "314907378+UserError418@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/UserError418/WatchThemAll",
  "repository": {
    "type": "git",
    "url": "https://github.com/UserError418/WatchThemAll.git"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
