<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      `enableOnBackInvokedCallback` opts in to the platform back API, which is
      what drives the predictive back gesture: dragging from the edge peels the
      current screen back to show what is behind it before the finger lifts.

      Safe alongside the JavaScript `backButton` listener in the bridge, because
      Capacitor 8's App plugin registers through AndroidX's
      `OnBackPressedDispatcher` rather than overriding the deprecated
      `onBackPressed()`; the dispatcher is the bridge between the two APIs and
      forwards either one to the same callback. Declared explicitly even though
      `targetSdk 36` already defaults it on, because that default is a moving
      target and this file is where someone will look for it.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Where the Cast SDK finds its configuration. The class is never
          constructed by our code; Play Services looks it up by this name.
        -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="net.watchthemall.app.CastOptionsProvider" />

        <!--
          Keeps the process, the CPU and the Wi-Fi radio alive while the phone
          is serving a stream to the television. `mediaPlayback` is required
          from Android 14 on; a service without a declared type refuses to
          start. See CastKeepAliveService for why this is not optional.
        -->
        <service
            android:name=".CastKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Casting only. ACCESS_WIFI_STATE and CHANGE_WIFI_MULTICAST_STATE are what
      let the Cast SDK find a Chromecast at all — discovery is mDNS, which is
      multicast, and without the lock the adapter filters it out while the
      screen is off. The rest keep the phone serving segments once it has.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
</manifest>
