<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's cloud backup and device-to-device transfer leave out
  (Android 12 on; backup_rules.xml says the same for older versions).

  The library (files/watchthemall.json) and the test history stay in: a
  backup that restores them is the point of allowing backup at all.

  CapacitorStorage.xml is Capacitor Preferences, which holds the Google
  Drive sign-in (sync.credentials, a refresh token that reaches the
  user's Drive) and a cached copy of the provider catalogue. A token
  restored onto another device would sign that device in without anyone
  pairing it, and a copy of it sits in the backup for as long as the
  backup exists. Left out, a restored phone asks to pair again; the
  catalogue is fetched again.

  Downloads (files/downloads/ and downloads.json) are left out: films of
  gigabytes would blow the backup quota and stop the library being backed
  up at all, and they are a copy of a stream, fetched again on demand.

  The preview cache is not listed because it is not backed up anyway: it
  lives in the cache directory, which backup never includes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="downloads.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="downloads.json" />
    </device-transfer>
</data-extraction-rules>
